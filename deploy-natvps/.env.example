# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Tên miền của app (đã chuyển DNS sang Cloudflare), không có https://
DOMAIN=ten-mien-cua-ban.com

# Token của Cloudflare Tunnel (Zero Trust → Networks → Tunnels → tunnel của bạn)
CLOUDFLARE_TUNNEL_TOKEN=<token>

# Mật khẩu database (tự đặt, chỉ dùng nội bộ)
DB_USERNAME=financehealth
DB_PASSWORD=<mat-khau-manh>

# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
JWT_SECRET=<chuoi-ngau-nhien>

# NAT VPS thường ổ nhỏ: nên dùng Object Storage chuẩn S3 cho ảnh/video.
# local = lưu trên ổ VPS, s3 = BizFly Simple Storage, VNG vStorage, FPT, Cloudflare R2...
STORAGE_TYPE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=auto
S3_PATH_STYLE=true

# Quét hóa đơn bằng AI (docs/DEPLOY-NATVPS.md mục 9). Thiếu key/project thì tắt, vẫn nhập tay được.
# anthropic = Claude (ANTHROPIC_API_KEY), gemini = Gemini trên Vertex AI (trừ vào credit Google Cloud)
RECEIPT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Chỉ dùng khi RECEIPT_PROVIDER=gemini
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-key.json

# Bộ nhớ cho Java, hợp với máy 1 GB RAM.
# Máy 2 GB trở lên: JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseSerialGC và tăng mem_limit của api lên 1g
JAVA_OPTS=-Xms128m -Xmx320m -XX:MaxMetaspaceSize=160m -Xss512k -XX:+UseSerialGC
