# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Tên miền của app (không có https://, không có www)
DOMAIN=ten-mien-cua-ban.com

# Mật khẩu database (tự đặt, chỉ dùng nội bộ trong server)
DB_USERNAME=financehealth
DB_PASSWORD=<mat-khau-manh>

# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
JWT_SECRET=<chuoi-ngau-nhien>

# Nơi lưu ảnh/video: local = ổ đĩa VPS (mặc định), s3 = Object Storage chuẩn S3
STORAGE_TYPE=local

# Chỉ điền khi STORAGE_TYPE=s3 (BizFly Simple Storage, VNG vStorage, FPT Object Storage...)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=hn
S3_PATH_STYLE=true

# Quét hóa đơn bằng AI. Để trống để tắt, vẫn nhập tay được.
ANTHROPIC_API_KEY=
