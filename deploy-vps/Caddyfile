# Web và API chung một tên miền. Caddy tự cấp và gia hạn HTTPS (Let's Encrypt).
{$DOMAIN} {
	encode gzip

	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /files/* {
		reverse_proxy api:8080
	}
	handle /actuator/health* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@nocache path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Chuyển www về tên miền chính (cần bản ghi DNS cho www, nếu không có thì xóa khối này)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
