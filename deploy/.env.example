# Copy thành .env trên server rồi điền giá trị thật. KHÔNG commit file .env.

# Tên miền cho API (Caddy dùng để cấp HTTPS)
API_DOMAIN=api.ten-mien-cua-ban.com

# Kết nối PostgreSQL (RDS)
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/financehealth
DB_USERNAME=financehealth
DB_PASSWORD=<mat-khau-manh>

# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
JWT_SECRET=<chuoi-ngau-nhien>

# Frontend được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGINS=https://ten-mien-cua-ban.com,https://www.ten-mien-cua-ban.com
PUBLIC_BASE_URL=https://api.ten-mien-cua-ban.com

# Lưu ảnh/video trên S3 (quyền lấy từ IAM role gắn vào EC2)
S3_BUCKET=financehealth-media-<ten-ban>
AWS_REGION=ap-southeast-1

# Quét hóa đơn bằng AI. Để trống để tắt, vẫn nhập tay được.
ANTHROPIC_API_KEY=
